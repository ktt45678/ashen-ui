{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/ashen-ui",
  "deleteDestPath": true,
  "lib": {
    "entryFile": "public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*.css",
      "input": "styles",
      "output": "styles"
    },
    {
      "glob": "**/*.{cjs,json}",
      "input": "styles/icons",
      "output": "styles/icons"
    }
  ]
}
