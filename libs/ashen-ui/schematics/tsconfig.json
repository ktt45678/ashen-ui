{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../../dist/ashen-ui/schematics",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmitOnError": true
  },
  "include": [
    "ng-add/**/*.ts",
    "theme/**/*.ts",
    "theme-sync/**/*.ts",
    "tokens.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/files/**"
  ]
}
