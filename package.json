{
  "name": "ashen-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm docs:snippets && ng serve showcase",
    "start:e2e": "pnpm docs:snippets && ng serve showcase --port 4301",
    "build": "pnpm docs:snippets && pnpm docs:llm && ng build showcase",
    "docs:api": "node scripts/generate-component-api.mjs",
    "docs:snippets": "node scripts/generate-doc-snippets.mjs",
    "docs:llm": "pnpm docs:api && node scripts/generate-llm-docs.mjs",
    "docs:check": "pnpm docs:api --check && pnpm docs:snippets --check && pnpm docs:llm",
    "build:lib": "ng build ashen-ui && node libs/ashen-ui/scripts/postbuild-package.mjs && node libs/ashen-ui/scripts/verify-exports.mjs && node libs/ashen-ui/scripts/build-schematics.mjs",
    "test": "ng test showcase --watch=false",
    "test:lib": "pnpm theme:check && ng test ashen-ui --watch=false",
    "test:schematics": "node libs/ashen-ui/scripts/build-schematics.mjs && vitest run --config libs/ashen-ui/schematics/vitest.config.ts",
    "verify:release": "pnpm lint && pnpm docs:check && pnpm test:lib && pnpm build:lib && pnpm build",
    "pack:lib": "npm pack ./dist/ashen-ui --dry-run",
    "publish:lib": "pnpm verify:release && npm publish ./dist/ashen-ui",
    "theme:generate": "node libs/ashen-ui/scripts/generate-tailwind-theme.mjs && node libs/ashen-ui/scripts/generate-token-manifest.mjs && node libs/ashen-ui/scripts/validate-theme.mjs --include src/styles/themes",
    "theme:check": "node libs/ashen-ui/scripts/generate-tailwind-theme.mjs --check && node libs/ashen-ui/scripts/generate-token-manifest.mjs --check && node libs/ashen-ui/scripts/validate-theme.mjs --check --include src/styles/themes",
    "watch": "ng build showcase --watch --configuration development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@fontsource-variable/material-symbols-outlined": "^5.2.45",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@fontsource-variable/outfit": "^5.2.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.1",
    "@angular-devkit/schematics": "22.2.1",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@schematics/angular": "22.2.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jasmine": "~5.1.0",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jasmine-core": "~5.9.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.4",
    "postcss": "^8.5.16",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.10"
  }
}
